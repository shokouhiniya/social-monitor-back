APP_NAME=Social Monitor
NODE_ENV=development

HOST=127.0.0.1
PORT=3000

DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=social_monitor
DB_NAME=social_monitor
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_AUTOLOADENTITIES=true

JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=60m

# Job Center / JobWorker (Requirement 10)
# JOBS_CONCURRENCY: حداکثر تعداد task هایی که worker هم‌زمان اجرا می‌کند (پیش‌فرض 5).
# JOBS_WORKER_ENABLED: آغاز خودکار حلقهٔ پس‌زمینهٔ worker هنگام بوت (پیش‌فرض false؛
#   تا اتصال executor واقعی fetch/analyze در تسک ۷.۶).
# JOBS_POLL_INTERVAL_MS: فاصلهٔ سرکشی حلقهٔ پس‌زمینه بر حسب میلی‌ثانیه (پیش‌فرض 1000).
JOBS_CONCURRENCY=5
JOBS_WORKER_ENABLED=false
JOBS_POLL_INTERVAL_MS=1000

# Bootstrap admin user for V2 AuthModule (Requirement 11).
# کاربر admin اولیه تنها در صورتی seed می‌شود که هر دو مقدار زیر تنظیم شوند.
# اگر تنظیم نشوند، seed با یک هشدار رد می‌شود (هیچ حساب پیش‌فرض ناامنی ساخته
# نمی‌شود). رمز عبور قوی انتخاب کنید.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
ADMIN_NAME=مدیر سیستم
# ADMIN_PHONE=09120000000

# Instagram API (RapidAPI)
RAPIDAPI_KEY=your_rapidapi_key_here

# OpenRouter (LLM)
OPENROUTER_API_KEY=your_openrouter_key_here

# Twitter API Providers (RapidAPI)
TWITTER_API_KEY_1=your_twitter_api_key_here
TWITTER_API_HOST_1=twitter241.p.rapidapi.com
TWITTER_API_KEY_2=your_twitter_api_key_here
TWITTER_API_HOST_2=twitter154.p.rapidapi.com
TWITTER_API_KEY_3=your_twitter_api_key_here
TWITTER_API_HOST_3=twitter-api45.p.rapidapi.com

# Telegram (from my.telegram.org)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION=your_session_string_from_telegram_auth_js
